[Unit]
Description=Hello RPC
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=hello-rpc

# CD 时替换
Image=IMAGE_PLACEHOLDER

Network=app.network

# 如果 RPC 只给 API 内部访问，
# 实际上可以不 PublishPort
# PublishPort=8080:8080

PodmanArgs=--memory=160m --cpus=0.8

Volume=/usr/share/zoneinfo/Asia/Shanghai:/etc/localtime:ro

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target